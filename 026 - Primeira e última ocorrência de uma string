frase = input('Digite uma frase: ').strip().lower()
contadorA = frase.count('a')
print(f'A letra "A" aparece {contadorA} vezes')
posicao = frase.find('a')+1
print(f'A primeira letra "A" apareceu na posição {posicao}')
ultima = frase.rfind('a')+1
print(f'A última posição que você encontra a letra "A" é na posição {ultima}')
